# =============================================================================
# 小光景部署环境变量模板
#
# 使用方式：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 修改下方带 【必改】/【待业务方提供】 标注的值
#   3. docker compose up -d 启动
#
# 说明：
#   - .env 包含密钥，已被 .gitignore 排除，严禁提交仓库
#   - docker-compose.yml 中 backend 服务会自动加载本文件全部变量
#   - DATABASE_URL 在 compose 中已强制指向 postgres 服务，此处配置仅
#     供脱离 compose 本地运行时参考（会被 compose 的 environment 覆盖）
# =============================================================================

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
# 【必改】PostgreSQL 密码（compose 中 postgres 服务与 backend 连接串共用）
DB_PASSWORD=change-me-strong-password
# 【可选】postgres 端口是否映射到宿主机；默认 5432。仅调试需要，生产建议留空不映射
POSTGRES_EXPOSE_PORT=5432

# 完整数据库连接串（SQLAlchemy 格式）
# 注意：docker compose 部署时无需修改，backend 的 environment 会覆盖为
# postgresql+psycopg2://postgres:${DB_PASSWORD}@postgres:5432/jiaban
DATABASE_URL=postgresql+psycopg2://postgres:change-me-strong-password@localhost:5432/jiaban

# ---------------------------------------------------------------------------
# 大模型（DeepSeek，OpenAI 兼容协议）
# ---------------------------------------------------------------------------
# 【待业务方提供】DeepSeek API Key（当前为开发占位值，生产必须替换）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 【可改】API 地址与模型名（模型名须在启动白名单内，否则拒绝启动）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 联调/CI 无外网时置 true 走本地假模型
LLM_MOCK=false

# ---------------------------------------------------------------------------
# Embedding 通道（RAG 检索层，spec rag-llamaindex-migration）
# ---------------------------------------------------------------------------
# zhipu=智谱 embedding-3 真实调用（境内已备案）；mock=确定性降级（联调/CI）
# 【待业务方提供】智谱 API Key（真实 key 只放本地 .env，严禁提交仓库）
EMBEDDING_PROVIDER=zhipu
ZHIPU_MODEL=embedding-3
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
# 向量维度（embedding-3 支持 1-2048；2048 维无 ANN 索引，顺序扫描）
EMBEDDING_DIMENSIONS=2048

# ---------------------------------------------------------------------------
# 向量库（Milvus standalone，spec milvus-vector-store：检索主通道存储后端）
# ---------------------------------------------------------------------------
# 空 = 主通道禁用（检索走 hashing 降级链）；compose 部署无需修改
# （backend 自动注入 http://milvus:19530），脱离 compose 本地直连时填写
# 【可改】Milvus SDK 地址与可选鉴权 token（standalone 默认无鉴权）
MILVUS_URI=
MILVUS_TOKEN=

# ---------------------------------------------------------------------------
# 安全密钥
# ---------------------------------------------------------------------------
# 【必改】JWT 签名密钥（生产必须换成长随机串，泄露即登录体系失守）
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-strong-jwt-secret
JWT_ISSUER=jiaban

# 【必改】字段加密主密钥（Fernet 格式 base64，加密手机号等敏感字段）
# 生成示例：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENC_KEY=change-me-strong-fernet-key

# 【可选】字段加密历史密钥（密钥轮换用；逗号分隔，顺序对应 v1..v{n-1}）
FIELD_ENC_KEYS_OLD=

# ---------------------------------------------------------------------------
# 缓存（可选 Redis）
# ---------------------------------------------------------------------------
# 【可选】Redis 地址，两种示例按部署形态二选一：
#   compose 内服务名： redis://redis:6379/0   （backend 容器连 compose 内 redis）
#   本机/宿主机直连： redis://localhost:6379/0 （脱离 compose 本地跑 uvicorn）
# docker compose 部署时无需修改：backend 的 environment 已默认注入
# REDIS_URL=redis://redis:6379/0（指向 compose 内 redis 服务），此处留空即可；
# 本地开发（脱离 compose 直接跑 uvicorn）建议留空 = 进程内缓存回退，
# 单实例部署完全可用（启动日志出现"进程内回退告警"属正常行为）。
REDIS_URL=
# REDIS_URL=redis://redis:6379/0
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# 微信登录（通道抽象 D1）
# ---------------------------------------------------------------------------
# 认证提供方：dev=开发 mock 登录；wx=微信 code2session（需下方凭据）
AUTH_PROVIDER=dev
# 【待业务方提供】微信小程序 AppID / AppSecret（留位，不伪造）
WX_APPID=
WX_SECRET=

# ---------------------------------------------------------------------------
# 支付（通道抽象 D1）
# ---------------------------------------------------------------------------
# 支付提供方：mock=模拟支付；wxpay=微信支付（需下方商户配置）
PAY_PROVIDER=mock
# 【待业务方提供】微信支付商户号
WXPAY_MCH_ID=
# 【待业务方提供】商户 API 证书序列号
WXPAY_SERIAL_NO=
# 【待业务方提供】商户私钥文件路径（容器内路径，需另行挂载）
WXPAY_PRIVATE_KEY_PATH=
# 【待业务方提供】APIv3 密钥
WXPAY_API_V3_KEY=
# 【待业务方提供】平台证书/公钥 PEM 路径（回调验签用，容器内路径；
# 平台证书（BEGIN CERTIFICATE）与微信支付公钥（BEGIN PUBLIC KEY）均支持，
# 按 PEM 头自动识别，二选一配置即可）
WXPAY_PLATFORM_CERT_PATH=
# 【待业务方提供】V3 支付结果回调通知地址（https 公网可达，JSAPI 下单必填；
# 回调落位 /api/v1/billing 路由，请按此在商户平台配置回调域名）
WXPAY_NOTIFY_URL=
# mock 支付验签密钥（仅 PAY_PROVIDER=mock 时使用）
PAY_MOCK_SIGN_KEY=jiaban-pay-mock-sign-key

# ---------------------------------------------------------------------------
# 敏感字段加密 Provider（local 默认 / kms 信封加密，配置即切）
# ---------------------------------------------------------------------------
# CRYPTO_PROVIDER=local：本地 Fernet（v{N}: 前缀多密钥轮换；既有密文无需迁移）
# CRYPTO_PROVIDER=kms：KMS 信封加密（KEK 包裹 DEK，AES-256-GCM；切换后跑
# scripts/rotate_field_key.py 可将存量 v{N}: 密文渐进迁移为 kms1: 信封格式）
CRYPTO_PROVIDER=local
# 【CRYPTO_PROVIDER=kms 时必填】KMS 主密钥（本地适配器实现下为环境变量
# 主密钥，KEK = SHA-256(本值)；接云 KMS 时改为云端主密钥句柄/密钥 ID）
KMS_MASTER_KEY=

# ---------------------------------------------------------------------------
# 内容安全平台回调（送检异步闭环）
# ---------------------------------------------------------------------------
# 【生产必须更换】平台回调 HMAC-SHA256 共享密钥；
# 留空 = /safety-scan/callback 拒绝全部回调（1901），本地联调需配置
SAFETY_SCAN_CALLBACK_SECRET=

# ---------------------------------------------------------------------------
# 业务参数与服务
# ---------------------------------------------------------------------------
# 每用户每日免费 AI 问答次数
FREE_QUOTA_DAILY=4

# 【可选】告警 webhook 通知地址（告警闭环推送）；留空 = 不通知
ALERT_WEBHOOK_URL=

# 后端监听端口（容器内固定 8000，此变量供本地脚本使用）
APP_PORT=8000
# uvicorn worker 数（容器部署用，默认 2）
UVICORN_WORKERS=2